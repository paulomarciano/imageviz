# Dependencies
node_modules/

# Build output
frontend/dist/

# IDE / Editors
.idea/
.vscode/
.obsidian/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Rust
backend/**/*.rs.bk
backend/**/target/
rust_out

# Test artifacts
coverage/
coverage-*.json
*.lcov

# Session / temp files
.tmp/

# Logs
*.log

# Thumbnail cache (generated at runtime — content-addressed WebP files)
data/thumbnails/

# Runtime data
data/
!data/.gitkeep

# ComfyUI test data (do not commit actual dataset)
~/ComfyUI/

# Test fixtures (binary media files — generated or copied from ComfyUI output)
# These are real ComfyUI outputs with metadata; do not commit to GitHub
test-fixtures/*.png
test-fixtures/*.webm
test-fixtures/*.mp4
test-fixtures/*.jpg
test-fixtures/*.jpeg
# Keep .gitkeep so the directory is always present after clone
!test-fixtures/.gitkeep
